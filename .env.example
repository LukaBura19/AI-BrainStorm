# ===========================================
# BrainStorm Booking - Environment Variables
# ===========================================
# Kopiraj ovaj fajl u .env i popuni vrednosti:
#   cp .env.example .env
#
# Za lokalni razvoj default vrednosti su dovoljne.

# ---- PostgreSQL ----
POSTGRES_USER=brainstorm
POSTGRES_PASSWORD=brainstorm_local
POSTGRES_DB=brainstorm_booking

# ---- Backend ----
DATABASE_URL=postgresql://brainstorm:brainstorm_local@postgres:5432/brainstorm_booking
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Prilozi uz rezervacije (PDF/slike); u Dockeru volumen mapira ovaj put
# UPLOAD_DIR=/app/uploads/booking_attachments
# MAX_ATTACHMENT_BYTES=26214400
# MAX_BOOKING_ATTACHMENTS=10

# ---- Frontend URL (za linkove u emailovima, npr. cancel link) ----
FRONTEND_URL=http://localhost:5174
APP_TIMEZONE=Europe/Belgrade

# ---- Admin seed podaci ----
ADMIN_EMAIL=admin@brainstorm.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Admin BrainStorm

# ---- Email (MailHog čuva test poruke; NE šalje u stvarna sandučeta) ----
MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@brainstorm.com
MAIL_ENABLED=true
MAIL_TIMEOUT_SECONDS=10
MAIL_TLS=false
MAIL_SSL=false
# smtp = pravi SMTP provajder; capture = test server. MailHog se prepoznaje automatski.
MAIL_DELIVERY_MODE=capture

# ---- AI asistent uz snimke za pripreme (Claude API) ----
# Ključ se pravi na https://platform.claude.com (API keys). Bez ključa stranice sa
# snimcima rade, a asistent javlja da još nije podešen.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (više = temeljniji, ali sporiji i skuplji odgovori)
CHAT_EFFORT=medium
# Najviše CHAT_RATE_LIMIT poruka sa jedne IP adrese u CHAT_RATE_WINDOW_SECONDS sekundi
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_SECONDS=600

# ---- Zaštićeni snimci (VdoCipher DRM) ----
# API Secret Key iz VdoCipher kontrolne table (Settings → API keys). Snimci sa vdocipher_id u
# katalogu puštaju se kroz Widevine/FairPlay DRM: ne mogu da se preuzmu, a snimanje ekrana daje
# crn ekran gde uređaj to podržava. Bez ključa ti snimci javljaju da trenutno nisu dostupni.
# FRONTEND_URL mora imati https:// i domen: propusnica za snimak radi samo na tom domenu.
VDOCIPHER_API_SECRET=

# Ako API stoji iza reverse proxy-ja (nginx, Caddy...), upiši IP adresu proxy-ja. Inače svi posetioci
# izgledaju kao jedna IP adresa: dele ograničenja poruka i propusnica, a vodeni žig gosta nosi IP proxy-ja.
# FORWARDED_ALLOW_IPS=127.0.0.1

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:8002
